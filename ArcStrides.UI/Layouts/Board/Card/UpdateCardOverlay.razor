@using ArcStrides.Contracts.Request.Create
@using ArcStrides.Contracts.Response
@using ArcStrides.UI.Components
@using ArcStrides.UI.Components.ArcOverlay
@using ArcStrides.UI.Layouts
@using ArcStrides.UI.Layouts.Board.Task
@using ArcStrides.UI.Models.Board
@using ArcStrides.UI.Options
@using ArcStrides.UI.Repositories
@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using System.Net.Http.Headers

@inherits LayoutComponentBase

<ArcOverlay @bind-Open="Open"
            OnSubmitAsync="UpdateCardAsync">
    <MudPaper Width="1100px" Height="500px" Style="background-color: transparent;">
        <MudStack>
            <MudItem>
                <MudGrid>
                    <MudItem Style="width:400px">
                        <MudStack Spacing="1">
                            <MudItem>
                                <MudGrid Spacing="0" Style="height: 75px">
                                    <MudItem Style="width: 240px;">
                                        <MudTextField @bind-Value="ActiveCard.Title" 
                                                      T="string"
                                                      Variant="Variant.Outlined"
                                                      HelperText="Card Title"
                                                      HelperTextOnFocus=true
                                                      Style="background-color: rgba(255, 255, 255, 0.6);
                                                             border-radius: 4px
                                                             width: 260px" />
                                    </MudItem>
                                    <MudItem>
                                        <MudPaper Style="background-color: rgba(204, 255, 204, 0.6);
                                                         border-radius: 4px"
                                                  Width="120px"
                                                  Height="60px">
                                            Tags...
                                        </MudPaper>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem>
                                @_taskList
                            </MudItem>
                        </MudStack>
                    </MudItem>
                    <MudItem Style="width: 700px; height: 400px">
                        <MudTextField @bind-Value="ActiveCard.Description" 
                                      T="string" 
                                      Lines="13"
                                      Variant="Variant.Outlined"
                                      AdornmentColor="Color.Transparent"
                                      HelperText="Card Description"
                                      HelperTextOnFocus=true
                                      Style="background-color: rgba(255, 255, 230, 0.8);
                                             border-radius: 4px"/>
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem>
                <MudGrid>
                    <MudItem>Timeline</MudItem>  
                    <MudItem>Notification</MudItem>
                </MudGrid>
            </MudItem>
        </MudStack>
    </MudPaper>
</ArcOverlay>

@inject ICardRepository _cardRepository;
@inject ITaskRepository _taskRepository;

@code 
{
    [Parameter]
    public bool Open { get; set; }
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public Guid BoardID { get; set; }
    [Parameter]
    public EventCallback<Guid> BoardIDChanged { get; set; }

    [Parameter]
    public Card ActiveCard { get; set; }
    [Parameter]
    public EventCallback<Card?> ActiveCardChanged { get; set; }

    [Parameter]
    public EventCallback<bool> Refresh { get; set; }

    public string _cardTitle = string.Empty;
    public string _cardDescription = string.Empty;

    //private bool editCardOverlayIsOpen = false;

    //private IEnumerable<Models.Board.Task>? _cardTasks = null;
    private Models.Board.Task? taskToCreate = null;

    protected override void OnInitialized ()
    {
        ActiveCard = new Card 
        {
            Id = Guid.Empty,
            Title = "[Placeholder Title]",
            Description = "[Placeholder Description]",
            Tasks = []
        };
        //_cardTasks = ActiveCard?.Tasks ?? [];
        _taskList = _taskListRenderFragment ();
    }

    private RenderFragment _taskList = __builder =>
    { 
        <MudPaper>Loading...</MudPaper>
    };

    private RenderFragment _taskListRenderFragment ()
    {
        return __builder =>
        {
            <MudPaper Class="d-inline-flex flex-grow-1 overflow-auto glass-inner-engraved" Style="width: 400px; height: 200px;">
                <MudStack Class="flex-grow-1" Width="100%" Height="100%">
                    <MudList T="string" ReadOnly="false">
                        @foreach (var taskIndex in Enumerable.Range (0, ActiveCard?.Tasks.Count() ?? 0))
                        {
                            <MudListItem><!-- I switched from bind-TaskTitle to just assigning TaskTitle for now due to response object not being bindable. Fix later.. Also fix TaskOrder later.. -->
                                <MudGrid>
                                    <MudItem Style="width: 350px;
                                                    background-color: transparent;">
                                        <UpdateTaskOverlay @bind-ActiveTask="ActiveCard!.Tasks [taskIndex]"
                                                           TasksCount="ActiveCard!.Tasks.Count"
                                                           CardID="ActiveCard!.Id"
                                                           BoardID="BoardID"/>
                                    </MudItem>
                                    <MudItem Style="width: 20px">
                                        <MudImage Width="20" 
                                                  Height="20"
                                                  Src="icons8-trashcan-50.png" 
                                                  @onclick="(()=> DeleteTaskAsync (ActiveCard!.Tasks [taskIndex].ID))"/>
                                    </MudItem>
                                </MudGrid>
                            </MudListItem>
                        }
                        <MudListItem>
                            <CreateTaskOverlay @bind-Task="taskToCreate"
                                               TasksCount="ActiveCard.Tasks.Count"
                                               CardID="ActiveCard?.Id"
                                               BoardID="BoardID" />
                        </MudListItem>
                    </MudList>
                </MudStack>
            </MudPaper>
        };
    }
}