@using ArcStrides.Contracts.Request.Create
@using ArcStrides.Contracts.Response
@using ArcStrides.UI.Components
@using ArcStrides.UI.Components.ArcOverlay
@using ArcStrides.UI.Layouts
@using ArcStrides.UI.Layouts.Board.Task
@using ArcStrides.UI.Models
@using ArcStrides.UI.Options
@using ArcStrides.UI.Repositories
@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using System.Net.Http.Headers

@inherits LayoutComponentBase

<ArcOverlay @bind-Open="Open"
            OnSubmitAsync="UpdateCard">
    <MudPaper Width="900px" Height="500px" Class="mud-background">
        <MudStack>
            <MudItem>
                <MudGrid>
                    <MudItem>
                        <MudStack>
                            <MudItem>
                                <MudGrid>
                                    <MudItem>
                                        <MudTextField @bind-Value="ActiveCard.Title" T="string" Label="Title" Variant="Variant.Filled" HelperText="Card Title" Class="mud-theme-secondary" />
                                    </MudItem>
                                    <MudItem>
                                        Tags...
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem></MudItem>
                            <MudItem>
                                @_taskList
                            </MudItem>
                        </MudStack>
                    </MudItem>
                    <MudItem>
                        <MudTextField @bind-Value="ActiveCard.Description" T="string" Label="Description" Variant="Variant.Filled" AutoGrow Lines="7" HelperText="Description" Class="mud-theme-secondary"/>
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem>
                <MudGrid>
                    <MudItem>Timeline</MudItem>  
                    <MudItem>Notification</MudItem>
                </MudGrid>
            </MudItem>
        </MudStack>
    </MudPaper>
</ArcOverlay>

@inject ICardRepository _cardRepository;

@code 
{
    [Parameter]
    public bool Open { get; set; }
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public Guid BoardID { get; set; }
    [Parameter]
    public EventCallback<Guid> BoardIDChanged { get; set; }

    [Parameter]
    public DropCard? ActiveCard { get; set; }
    [Parameter]
    public EventCallback<DropCard?> ActiveCardChanged { get; set; }

    [Parameter]
    public EventCallback<bool> Refresh { get; set; }

    public string _cardTitle = string.Empty;
    public string _cardDescription = string.Empty;

    private Guid? CardID = null;

    private bool editCardOverlayIsOpen = false;

    protected override void OnInitialized ()
    {
        _taskList = _taskListRenderFragment ();
    }

    private RenderFragment _taskList = __builder => 
    { 
        <MudPaper>Loading...</MudPaper>
    };

    private RenderFragment _taskListRenderFragment ()
    {
        return __builder =>
        {
            <MudPaper Class="d-inline-flex flex-grow-1 overflow-auto" Style="width: 350px; height: 200px;">
                <MudStack Class="flex-grow-1" Width="100%" Height="100%">
                    <MudList T="string" ReadOnly="false">
                        @foreach (var task in ActiveCard.Tasks)
                        {
                            <MudListItem><!-- I switched from bind-TaskTitle to just assigning TaskTitle for now due to response object not being bindable. Fix later.. Also fix TaskOrder later.. -->
                                <UpdateTaskOverlay TaskID="@task.ID!.Value"
                                                   TaskTitle="@task.Title"
                                                   TaskOrder="1"
                                                   @bind-CardID="CardID" 
                                                   @bind-BoardID="BoardID" />
                            </MudListItem>
                        }
                        <MudListItem>
                            <CreateTaskOverlay TaskTitle="Add New Task"
                                               TaskOrder="1"
                                               @bind-CardID="CardID"
                                               @bind-BoardID="BoardID" />
                        </MudListItem>
                    </MudList>
                </MudStack>
            </MudPaper>
        };
    }

    private void Fire (bool changed)
    {
        if (ActiveCard is not null)
        {
            _cardTitle = ActiveCard.Title;
            _cardDescription = ActiveCard.Description;
        }
    }
}