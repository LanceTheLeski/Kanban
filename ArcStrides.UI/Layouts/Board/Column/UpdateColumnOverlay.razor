@using ArcStrides.UI.Components
@using ArcStrides.UI.Components.ArcExpandingSelector
@using ArcStrides.UI.Components.ArcOverlay
@using ArcStrides.UI.Options
@using ArcStrides.UI.Repositories
@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using ArcStrides.UI.Models
@using System.Net.Http.Headers

@rendermode RenderMode.InteractiveServer

<ArcOverlay @bind-Open="Open"
            OnSubmitAsync="UpdateColumnAsync">

    <MudText>Edit Column</MudText>

    <ArcExpandingSelector @bind-Options="ColumnTitles"
                          OptionSelected="SetColumnNameToUpdate" />

    <MudTextField T="string" 
                  @bind-Value="_columnTitleReplacement" 
                  Label="New Title" 
                  Variant="Variant.Filled" 
                  AutoGrow 
                  HelperText="Column Title" />

    <ArcExpandingSelector @bind-Options='_columnOrderList'
                          OptionSelected="@((orderSelected) => _columnOrderSelected = int.Parse(orderSelected))" />

 </ArcOverlay>

 @inject IColumnRepository _columnRepository

@code 
{
    [Parameter]
    public bool Open { get; set; }
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public Guid BoardID { get; set; }
    [Parameter]
    public EventCallback<Guid> BoardIDChanged { get; set; }

    [Parameter]
    public List<Guid> Columns { get; set; }
    [Parameter]
    public EventCallback<List<Guid>> ColumnsChanged { get; set; }

    [Parameter]
    public List<string> ColumnTitles { get; set; }
    [Parameter]
    public EventCallback<List<string>> ColumnTitlesChanged { get; set; }

    [Parameter]
    public EventCallback<bool> Refresh { get; set; }

    protected override void OnParametersSet ()
    {
        base.OnParametersSet();

        GetColumnIndexList();
    }

    private List<string> _columnOrderList = new ();

    private string _columnTitleSelected = string.Empty;
    private string _columnTitleReplacement = string.Empty;

    private int _columnOrderSelected = -1;
}