@using ArcStrides.UI.Repositories

@inherits LayoutComponentBase

<MudGrid>
    <MudItem>
        <MudStack>
            <MudItem Style="background-color: lightgoldenrodyellow">
                <MudButton Size="Size.Small" 
                           OnClick="@(() => TimelineFragmentChanged (false))">
                    Deadline
                </MudButton>
            </MudItem>
            <MudItem Style="background-color: aquamarine">
                <MudButton Size="Size.Small" 
                           OnClick="@(() => TimelineFragmentChanged (true))">
                    Timeline
                </MudButton>
            </MudItem>
        </MudStack>
    </MudItem>

    <MudItem>
        @_timelineFragment
    </MudItem>
</MudGrid>

@inject ITimelineRepository _timelineRepository;

@code 
{
    [Parameter]
    public Guid? BoardID { get; set; }

    [Parameter]
    public Models.Board.Timeline? Timeline { get; set; }
    [Parameter]
    public EventCallback<Models.Board.Timeline> TimelineChanged { get; set; }

    private DateRange _dateRangePreferred = new DateRange();
    private TimeSpan? _timePreferredStart = new TimeSpan();
    private TimeSpan? _timePreferredEnd = new TimeSpan();

    private DateRange _dateRangeRequired = new DateRange();
    private TimeSpan? _timeRequiredStart = new TimeSpan();
    private TimeSpan? _timeRequiredEnd = new TimeSpan();

    protected override void OnInitialized()
    {
        _timelineFragment = _deadlineRenderFragment();
    }

    private RenderFragment _timelineFragment;
    private RenderFragment _timelineRenderFragment()
    {
        return __builder =>
        {
            <MudPaper Class="d-flex flex-column" 
                      Style="width: 460px; 
                             height: 120px;
                             background-color: aquamarine;">
                <MudPaper Class="d-flex flex-row"
                          Style="background-color: aquamarine">
                    <MudDateRangePicker Label="Preferrd" 
                                        Editable="true"
                                        @bind-DateRange="_dateRangePreferred" />    
                    <MudTimePicker Label="Preferred Start" 
                                   Editable="true" 
                                   AmPm="true" 
                                   AnchorOrigin="Origin.CenterLeft" 
                                   TransformOrigin="Origin.CenterRight"
                                   @bind-Time="_timePreferredStart" />
                    <MudTimePicker Label="Preferred End" 
                                   Editable="true" 
                                   AmPm="true"
                                   @bind-Time="_timePreferredEnd" />
                </MudPaper>
                <MudPaper Class="d-flex flex-row"
                          Style="background-color: aquamarine">
                    <MudDateRangePicker Label="Deadlines" 
                                        Editable="true" 
                                        @bind-DateRange="_dateRangeRequired"/>                     
                    <MudTimePicker Label="Required Start" 
                                   Editable="true" 
                                   AmPm="true" 
                                   @bind-Time="_timeRequiredStart" />                   
                    <MudTimePicker Label="Required End" 
                                   Editable="true" 
                                   AmPm="true" 
                                   @bind-Time="_timeRequiredEnd" />
                </MudPaper>
            </MudPaper>
        };
    }
    private RenderFragment _deadlineRenderFragment()
    {
        return __builder =>
        {
            <MudPaper Class="d-inline-flex flex-grow-1" 
                      Style="width: 460px; 
                             height: 120px;
                             background-color: lightgoldenrodyellow;">
                <MudDatePicker Label="EndDate" 
                               Editable="false" 
                               @bind-Date="_dateRangeRequired.End" />
                <MudTimePicker Label="Required End" 
                               Editable="true" 
                               AmPm="true" 
                               @bind-Time="_timeRequiredEnd" />
            </MudPaper>
        };
    }
}