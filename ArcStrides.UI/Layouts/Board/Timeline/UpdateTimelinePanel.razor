@using ArcStrides.UI.Repositories

@inherits LayoutComponentBase

<MudGrid>
    <MudItem>
        <MudStack>
            <MudItem Style="background-color: lightgoldenrodyellow">
                <MudButton Size="Size.Small" 
                           OnClick="@(() => TimelineFragmentChanged (false))">
                    Deadline
                </MudButton>
            </MudItem>
            <MudItem Style="background-color: aquamarine">
                <MudButton Size="Size.Small" 
                           OnClick="@(() => TimelineFragmentChanged (true))">
                    Timeline
                </MudButton>
            </MudItem>
        </MudStack>
    </MudItem>

    <MudItem>
        @_timelineFragment
    </MudItem>
</MudGrid>

@inject ITimelineRepository _timelineRepository;

@code 
{
    [Parameter]
    public Guid? BoardID { get; set; }

    [Parameter]
    public Models.Board.Timeline? Timeline { get; set; }
    [Parameter]
    public EventCallback<Models.Board.Timeline> TimelineChanged { get; set; }

    public DateRange _dateRangePreferred = new DateRange();
    public TimeSpan? _timePreferredStart = new TimeSpan();
    public TimeSpan? _timePreferredEnd = new TimeSpan();

    public DateRange _dateRangeRequired = new DateRange();
    public TimeSpan? _timeRequiredStart = new TimeSpan();
    public TimeSpan? _timeRequiredEnd = new TimeSpan();

    protected override void OnInitialized()
    {
        if (Timeline is null || isDeadline() is true)
            _timelineFragment = _deadlineRenderFragment();
        else
            _timelineFragment = _timelineRenderFragment();

        _dateRangePreferred.Start = Timeline?.StartPreferenceUTC;
        _timePreferredStart = Timeline.StartPreferenceUTC.Value.TimeOfDay;
        
        _dateRangePreferred.End = Timeline?.EndPreferenceUTC;
        _timePreferredEnd = Timeline.EndPreferenceUTC.Value.TimeOfDay;

        _dateRangeRequired.Start = Timeline?.StartDeadlineUTC;
        _timeRequiredStart = Timeline.StartDeadlineUTC.Value.TimeOfDay;

        _dateRangeRequired.End = Timeline?.EndDeadlineUTC;
        _timeRequiredEnd = Timeline.EndDeadlineUTC.Value.TimeOfDay;

    }

    private RenderFragment _timelineFragment;
    private RenderFragment _timelineRenderFragment()
    {
        return __builder =>
        {
            <MudPaper Class="d-flex flex-column" 
                      Style="width: 460px; 
                             height: 120px;
                             background-color: aquamarine;">
                <MudPaper Class="d-flex flex-row"
                          Style="background-color: aquamarine">
                    <MudDateRangePicker Label="Preferrd" 
                                        Editable="true"
                                        @bind-DateRange="_dateRangePreferred" />    
                    <MudTimePicker Label="Preferred Start" 
                                   Editable="true" 
                                   AmPm="true" 
                                   AnchorOrigin="Origin.CenterLeft" 
                                   TransformOrigin="Origin.CenterRight"
                                   @bind-Time="_timePreferredStart" />
                    <MudTimePicker Label="Preferred End" 
                                   Editable="true" 
                                   AmPm="true"
                                   @bind-Time="_timePreferredEnd" />
                </MudPaper>
                <MudPaper Class="d-flex flex-row"
                          Style="background-color: aquamarine">
                    <MudDateRangePicker Label="Deadlines" 
                                        Editable="true" 
                                        @bind-DateRange="_dateRangeRequired"/>                     
                    <MudTimePicker Label="Required Start" 
                                   Editable="true" 
                                   AmPm="true" 
                                   @bind-Time="_timeRequiredStart" />                   
                    <MudTimePicker Label="Required End" 
                                   Editable="true" 
                                   AmPm="true" 
                                   @bind-Time="_timeRequiredEnd" />
                </MudPaper>
            </MudPaper>
        };
    }
    private RenderFragment _deadlineRenderFragment()
    {
        return __builder =>
        {
            <MudPaper Class="d-inline-flex flex-grow-1" 
                      Style="width: 460px; 
                             height: 120px;
                             background-color: lightgoldenrodyellow;">
                <MudDatePicker Label="EndDate" 
                               Editable="false" 
                               @bind-Date="_dateRangeRequired.End" />
                <MudTimePicker Label="Required End" 
                               Editable="true" 
                               AmPm="true" 
                               @bind-Time="_timeRequiredEnd" />
            </MudPaper>
        };
    }

    private bool isDeadline ()
    {
        return Timeline.StartDependencyTagGroupID is not null
               || Timeline.StartDeadlineUTC is not null
               || Timeline.StartDeadlineUTC is not null
               || Timeline.EndDependencyTagGroupID is not null
               || Timeline.EndPreferenceUTC is not null;
    }
}