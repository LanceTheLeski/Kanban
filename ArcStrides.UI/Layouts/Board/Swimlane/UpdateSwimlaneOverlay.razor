@using ArcStrides.UI.Components.ArcExpandingSelector
@using ArcStrides.UI.Components.ArcOverlay
@using ArcStrides.UI.Models
@using ArcStrides.UI.Options
@using ArcStrides.UI.Repositories
@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using System.Net.Http.Headers

@rendermode RenderMode.InteractiveServer

<ArcOverlay @bind-Open="Open"
            OnSubmitAsync="UpdateSwimlane">
    
    <MudText>Edit Swimlane</MudText>

    <ArcExpandingSelector @bind-Options="SwimlaneTitles"
                          OptionSelected="SetSwimlaneNameToUpdate" />

    <MudTextField T="string" 
                  @bind-Value="_swimlaneTitleReplacement" 
                  Label="New Title" 
                  Variant="Variant.Filled" 
                  AutoGrow 
                  HelperText="Swimlane Title" />

    <ArcExpandingSelector @bind-Options="_swimlaneTitleList"
                          OptionSelected="@((str) => _swimlaneOrderSelected = int.Parse(str))" />

</ArcOverlay>

 @inject ISwimlaneRepository _swimlaneRepository;

@code 
{
    [Parameter]
    public bool Open { get; set; }
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public Guid BoardID { get; set; }
    [Parameter]
    public EventCallback<Guid> BoardIDChanged { get; set; }

    [Parameter]
    public List<Guid> Swimlanes { get; set; }
    [Parameter]
    public EventCallback<List<Guid>> SwimlanesChanged { get; set; }

    [Parameter]
    public List<string> SwimlaneTitles { get; set; }
    [Parameter]
    public EventCallback<List<string>> SwimlaneTitlesChanged { get; set; }

    [Parameter]
    public EventCallback<bool> Refresh { get; set; }

    protected override void OnInitialized ()
    {
        GetSwimlaneIndexList ();
    }

    private List<string> _swimlaneTitleList = new ();
    private string _swimlaneTitleSelected = string.Empty;
    private string _swimlaneTitleReplacement = string.Empty;

    private int _swimlaneOrderSelected = -1;
}