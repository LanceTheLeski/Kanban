@inherits LayoutComponentBase

<!--This should ideally be a component one day..-->
<MudPaper>
    <MudButton OnClick="@(() => tempOpen = true)">
        @TaskTitle
    </MudButton>
    <MudPopover Open="tempOpen" OverflowBehavior="OverflowBehavior.FlipAlways" AnchorOrigin="Origin.CenterRight" TransformOrigin="Origin.CenterLeft">
        <MudPaper Width="600px">
            <MudTextField @bind-Value="TaskTitle" T="string" Label="Title" Variant="Variant.Filled" HelperText="Task Title" />

            <MudGrid>
                <MudItem>
                    <MudPaper>
                        @TaskOrder
                    </MudPaper>
                    <ArcExpandingSelector Options="_taskTypes.Select (taskType => taskType!.Title!).ToList ()"
                                          OptionSelected="SetTaskTypeOnTask" />
                    <!--<MudExpansionPanels>
                        <MudExpansionPanel Text="Task Type" MaxHeight="1000" ExpandedChanged="TaskTypeListExpandedChanged">
                            @_taskTypeList
                        </MudExpansionPanel>
                    </MudExpansionPanels>-->
                </MudItem>
                <MudItem>
                    <TimelineEditor />
                    <!--<MudButton OnClick="@(() => TimelineFragmentChanged (false))">
                        Deadline
                    </MudButton>
                    <MudButton OnClick="@(() => TimelineFragmentChanged (true))">
                        Timeline
                    </MudButton>
                    <MudPaper>
                        @_timelineFragment
                    </MudPaper>-->
                </MudItem>
            </MudGrid>

            <MudButtonGroup>
                <MudButton OnClick="@(() => CreateTaskAsync())">Submit</MudButton>
                <MudButton OnClick="@(() => tempOpen = false)">Discard</MudButton>
            </MudButtonGroup>
        </MudPaper>
    </MudPopover>
</MudPaper>

@inject ITaskRepository _taskRepository;

