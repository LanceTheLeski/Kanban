@using ArcStrides.Contracts.Request.Create
@using ArcStrides.Contracts.Response
@using ArcStrides.UI.Components.ArcExpandingSelector
@using ArcStrides.UI.Layouts.Board.Timeline
@using ArcStrides.UI.Models
@using ArcStrides.UI.Options
@using ArcStrides.UI.Repositories
@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using System.Net.Http.Headers

@using static ArcStrides.Contracts.Response.BoardResponse
@using static ArcStrides.Contracts.Response.MonthResponse

@inherits LayoutComponentBase

<!--This should ideally be a component one day..-->
<MudPaper>
    <MudButton OnClick="@(() => tempOpen = true)">
        @Task.Title
    </MudButton>
    <MudPopover Open="tempOpen" OverflowBehavior="OverflowBehavior.FlipAlways" AnchorOrigin="Origin.CenterRight" TransformOrigin="Origin.CenterLeft">
        <MudPaper Width="600px">
            <MudTextField @bind-Value="Task.Title" T="string" Label="Title" Variant="Variant.Filled" HelperText="Task Title" />

            <MudGrid>
                <MudItem>
                    <ArcExpandingSelector Options="new List<string> {bool.TrueString, bool.FalseString}"
                                          OptionSelected="((string selection) => Task.IsCompleted = bool.Parse (selection))" />
                    <ArcExpandingSelector Options="_taskOrderRange"
                                          OptionSelected="SetTaskOrderOnTask" />
                    <ArcExpandingSelector Options="_taskTypes.Select (taskType => taskType!.Title!).ToList ()"
                                          OptionSelected="SetTaskTypeOnTask" />
                </MudItem>
                <MudItem>
                    <TimelineEditor />
                </MudItem>
            </MudGrid>

            <MudButtonGroup>
                <MudButton OnClick="@(() => CreateTaskAsync())">Submit</MudButton>
                <MudButton OnClick="@(() => tempOpen = false)">Discard</MudButton>
            </MudButtonGroup>
        </MudPaper>
    </MudPopover>
</MudPaper>

@inject ITaskRepository _taskRepository;

@code
{
    private bool tempOpen = false;

    [Parameter]
    public Models.Board.Task Task { get; set; }
    [Parameter]
    public EventCallback<Models.Board.Task> TaskChanged { get; set; }

    [Parameter]
    public IEnumerable<Models.Board.Task> Tasks { get; set; }
    [Parameter]
    public EventCallback<IEnumerable<Models.Board.Task>> TasksChanged { get; set; }

    /*[Parameter]
    public Date.Day Day { get; set; }
    [Parameter]
    public EventCallback<Date.Day> DayChanged { get; set; }*/

    [Parameter]
    public Guid? CardID { get; set; }
    [Parameter]
    public EventCallback<Guid?> CardIDChanged { get; set; }

    [Parameter]
    public Guid BoardID { get; set; }
    [Parameter]
    public EventCallback<Guid> BoardIDChanged { get; set; }

    [Parameter]
    public EventCallback<bool> Refresh { get; set; }

    private List<string> _taskOrderRange = new List<string>();

    private List<TaskTypeResponse> _taskTypes = new List<TaskTypeResponse> ();
    private TaskTypeResponse taskTypeToAssign = default;

    //On page load. Not async to this layout class loading.
    protected async override Task OnInitializedAsync ()
    {
        _taskTypes = await FetchTaskTypesAsync ("0");

        _taskOrderRange = new List<string>();
        for (int index = 1; index <= Tasks.Count (); index ++)
            _taskOrderRange.Add(index.ToString());
    }
}