@using ArcStrides.Contracts.Response
@using ArcStrides.UI.Components
@using ArcStrides.UI.Components.ArcOverlay
@using ArcStrides.UI.Repositories

<ArcOverlay @bind-Open="Open"
            OnSubmitAsync="UpdateTaskAsync">

    <MudText>@TaskData.Title</MudText>

    <MudText>Completed: @(TaskData.isCompleted)</MudText>

    <!--<MudExpansionPanels>
        <MudExpansionPanel Text="Column" MaxHeight="1000" ExpandedChanged="TaskTypeListExpandedChanged">
            @_taskTypeList
        </MudExpansionPanel>
    </MudExpansionPanels>

    <MudExpansionPanels>
        <MudExpansionPanel Text="Swimlane" MaxHeight="1000" ExpandedChanged="SwimlaneListExpandedChanged">
            @_swimlaneList
        </MudExpansionPanel>
    </MudExpansionPanels>-->
</ArcOverlay>

@inject ITaskRepository _taskRepository;

@code 
{
    [Parameter]
    public bool Open { get; set; }
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public Guid BoardID { get; set; }
    [Parameter]
    public EventCallback<Guid> BoardIDChanged { get; set; }

    [Parameter]
    public TaskResponse TaskData { get; set; }
    [Parameter]
    public EventCallback<TaskResponse> TaskDataChanged { get; set; }

    [Parameter]
    public EventCallback<bool> Refresh { get; set; }

    private static bool _taskViewIsOpen = false;
    private static CardResponse _taskToView = null;
}