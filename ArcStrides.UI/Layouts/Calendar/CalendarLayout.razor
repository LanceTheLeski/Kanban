<MudPaper Style="width: 100%; background-color: transparent">
    <MudGrid Justify="Justify.Center" Spacing="0" Style="background-color: transparent">
        <MudItem Style="padding-left: 2px; padding-right: 2px">
            <MudPaper Width="170px;" Style="background-color: #2494E7; color:azure; text-align: center;">
                Sunday
            </MudPaper>
        </MudItem>
        <MudItem Style="padding-left: 2px; padding-right: 2px">
            <MudPaper Width="170px;" Style="background-color: #2494E7; color:azure; text-align: center;">
                Monday
            </MudPaper>
        </MudItem>
        <MudItem Style="padding-left: 2px; padding-right: 2px">
            <MudPaper Width="170px;" Style="background-color: #2494E7; color:azure; text-align: center;">
                Tuesday
            </MudPaper>
        </MudItem>
        <MudItem Style="padding-left: 2px; padding-right: 2px">
            <MudPaper Width="170px;" Style="background-color: #2494E7; color:azure; text-align: center;">
                Wednesday
            </MudPaper>
        </MudItem>
        <MudItem Style="padding-left: 2px; padding-right: 2px">
            <MudPaper Width="170px;" Style="background-color: #2494E7; color:azure; text-align: center;">
                Thursday
            </MudPaper>
        </MudItem>
        <MudItem Style="padding-left: 2px; padding-right: 2px">
            <MudPaper Width="170px;" Style="background-color: #2494E7; color:azure; text-align: center;">
                Friday
            </MudPaper>
        </MudItem>
        <MudItem Style="padding-left: 2px; padding-right: 2px">
            <MudPaper Width="170px;" Style="background-color: #2494E7; color:azure; text-align: center;">
                Saturday
            </MudPaper>
        </MudItem>
    </MudGrid>


    <!--@dateFragment-->
    <MudGrid Justify="Justify.Center" Spacing="0" Style="background-color: transparent;">
        @foreach (var weekIndex in Enumerable.Range(0, _monthDates.Count () / 7))
        {
            <MudItem Style="height: 170px;
                            margin-bottom: 8px;">
                <MudPaper Height="170px" 
                          Style="background-color: transparent;">

                    <MudGrid Justify="Justify.Center" Spacing="0">
                        <MudItem Style="padding-left: 2px; padding-right: 2px; height: 170px;">
                            <CalendarDate @bind-Date="@(_monthDates [weekIndex * 7])"/>
                        </MudItem>
                        <MudItem Style="padding-left: 2px; padding-right: 2px; height: 170px;">
                            <CalendarDate @bind-Date="@(_monthDates [weekIndex * 7 + 1])" />
                        </MudItem>
                        <MudItem Style="padding-left: 2px; padding-right: 2px; height: 170px;">
                            <CalendarDate @bind-Date="@(_monthDates [weekIndex * 7 + 2])" />
                        </MudItem>
                        <MudItem Style="padding-left: 2px; padding-right: 2px; height: 170px;">
                            <CalendarDate @bind-Date="@(_monthDates [weekIndex * 7 + 3])" />
                        </MudItem>
                        <MudItem Style="padding-left: 2px; padding-right: 2px; height: 170px;">
                            <CalendarDate @bind-Date="@(_monthDates [weekIndex * 7 + 4])" />
                        </MudItem>
                        <MudItem Style="padding-left: 2px; padding-right: 2px; height: 170px;">
                            <CalendarDate @bind-Date="@(_monthDates [weekIndex * 7 + 5])" />
                        </MudItem>
                        <MudItem Style="padding-left: 2px; padding-right: 2px; height: 170px;">
                            <CalendarDate @bind-Date="@(_monthDates [weekIndex * 7 + 6])" />
                        </MudItem>
                    </MudGrid>

                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

@inject ICalendarRepository _calendarRepository;
@inject DateMapper _dateMapper;

@code
{
    public EventCallback<bool> Refresh { get; set; }

    private UpdateCardOverlay updateCardOverlay;
    private UpdateTaskPopover updateTaskOverlay;

    private List<Date> _monthDates = new List<Date> ();

    protected override async System.Threading.Tasks.Task OnInitializedAsync ()
    {
        var monthResponse = await _calendarRepository.FetchMonthAsync (Guid.Parse ("6469d898-c468-4c84-82f9-6dcad60757a8")); // One day this GUId will be dynamic
        // Validation goes here..

        var basicMonthDates = GetAllBasicMonthDatesFromSystem (2025, 1).ToList ();

        foreach (var dateResponse in monthResponse!.Dates!)
        {
            var monthDate = basicMonthDates.SingleOrDefault(basicMonthDate => basicMonthDate.DateOrder! == dateResponse.DateOrder!);
            // Validation goes here to check for null. If there's a null then something terrible has happened with the data..

            monthDate = _dateMapper.MapDateResponseToDate (dateResponse);
            monthDate.DonutChartData = /*[ 1.4, 3.7, 7.9, 4.9 ];*/ CountTasksForEachBoardType (monthDate.Cards);
            monthDate.LineChartData = /*[ new ChartSeries { Data = [0, 0, 5, 5, 5, 5, 10, 10] },
                                        new ChartSeries { Data = [0, 0, 2, 2, 2, 2, 2, 2] },
                                        new ChartSeries { Data = [0, 0, 1, 2, 4, 5, 6, 6] }];*/
                                        GetFormattedBoardTypeData (monthDate.Cards);
            monthDate.Labels = new string [] { };//todo..
            monthDate.xAxisLabels = new string [] { };//todo..

            var index = basicMonthDates.FindIndex (date => date.DateOrder == monthDate.DateOrder);
            basicMonthDates [index] = monthDate;
        }

        // Fill in the surrounding dates from other months so the calendar grid can render correctly
        var previousBasicMonthDates = GetAllBasicMonthDatesFromSystem (2024, 12).ToList ();
        for (int dayOfTheWeekOrder = (basicMonthDates [0].DayOfTheWeekOrder!.Value - 1); dayOfTheWeekOrder >= 0; dayOfTheWeekOrder --)
        {
            basicMonthDates.Insert (0, previousBasicMonthDates.Last (date => date.DayOfTheWeekOrder == dayOfTheWeekOrder));
        }

        var nextBasicMonthDates = GetAllBasicMonthDatesFromSystem (2025, 2).ToList ();
        for (int dayOfTheWeekOrder = (basicMonthDates.Last().DayOfTheWeekOrder!.Value + 1); dayOfTheWeekOrder < 7; dayOfTheWeekOrder ++)
        {
            basicMonthDates.Add (nextBasicMonthDates.First (date => date.DayOfTheWeekOrder == dayOfTheWeekOrder));
        }
        // Need to assign blank values to charts and graphs..

        // Then validate

        _monthDates = basicMonthDates;
    }
}