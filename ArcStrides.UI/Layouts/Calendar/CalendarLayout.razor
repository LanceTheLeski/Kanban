    private Month GetAllMonthDates (int year, int month)
    {
        var daysInMonth = DateTime.DaysInMonth (year, month);
        var firstDayOfMonth = new DateTime (year, month, 1);

        var newMonth = new Month ();

        newMonth.Weeks = new List<Week> ();
        newMonth.Weeks.Add (new Week ());
        var weekIndex = 0;

        for (var dayIndex = 0; dayIndex < daysInMonth; dayIndex ++)
        {
            switch (dayIndex % 7)
            {
                case 0:
                    newMonth.Weeks [weekIndex].Sunday = new Day { DayOfTheMonth = dayIndex, Cards = new List<MonthResponse.BasicCard> { } };
                    break;
                case 1:
                    newMonth.Weeks [weekIndex].Monday = new Day { DayOfTheMonth = dayIndex, Cards = new List<MonthResponse.BasicCard> { } };
                    break;
                case 2:
                    newMonth.Weeks [weekIndex].Tuesday = new Day { DayOfTheMonth = dayIndex, Cards = new List<MonthResponse.BasicCard> { } };
                    break;
                case 3:
                    newMonth.Weeks [weekIndex].Wednesday = new Day { DayOfTheMonth = dayIndex, Cards = new List<MonthResponse.BasicCard> { } };
                    break;
                case 4:
                    newMonth.Weeks [weekIndex].Thursday = new Day { DayOfTheMonth = dayIndex, Cards = new List<MonthResponse.BasicCard> { } };
                    break;
                case 5:
                    newMonth.Weeks [weekIndex].Friday = new Day { DayOfTheMonth = dayIndex, Cards = new List<MonthResponse.BasicCard> { } };
                    break;
                case 6:
                    newMonth.Weeks [weekIndex].Saturday = new Day { DayOfTheMonth = dayIndex, Cards = new List<MonthResponse.BasicCard> { } };
                    newMonth.Weeks.Add (new Week ());
                    weekIndex += 1;
                    break;
            } 
        }

        return newMonth;
    }

    private double [] CountBoardTypes (List<MonthResponse.BasicCard> cards)
    {
        var cardsDistinctByType = cards.Select (card => card.BoardID)
                                       .Distinct ();

        var cardCounts = new double [cardsDistinctByType.Count ()];
        for (var cardCountIndex = 0; cardCountIndex < cardCounts.Length; cardCountIndex ++)
            cardCounts [cardCountIndex] = cards.Where (card => card.BoardID == cardsDistinctByType.ElementAt (cardCountIndex))
                                               .Count ();

        return cardCounts;
    }

    private List<ChartSeries> GetBoardTypeData (List<MonthResponse.BasicCard> cards)
    {
        var boardTypesList = cards.Select (card => card.BoardID)
                                  .Distinct ();

        var cardsCompletedList = new List<ChartSeries> ();
        foreach (var boardType in boardTypesList)
        {
            var tasksCompleted = new double [boardTypesList.Count ()];
            for (var tasksIndex = 0; tasksIndex < tasksCompleted.Length; tasksIndex++)
                tasksCompleted [tasksIndex] = cards.Where (card => card.BoardID == boardTypesList.ElementAt (tasksIndex))
                                                   .Select (card => card.Tasks.Where (task => task.isCompleted == true))
                                                   .Count ();

            cardsCompletedList.Add (new ChartSeries { Data = tasksCompleted });
        }

        return cardsCompletedList;
    }

