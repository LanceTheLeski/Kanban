@inject ICalendarRepository _calendarRepository;

@code
{
    private ChartOptions options = new ChartOptions ()
    {
        ShowLegend = false,
        YAxisTicks = 7,
        LineStrokeWidth = 10
    };

    private IEnumerable<Date> _monthDates;

    protected override async Task OnInitializedAsync ()
    {
        //Test call here:
        //var month = GetAllMonthDates (2024, 8);

        var monthResponse = await _calendarRepository.FetchMonthAsync (Guid.Parse ("55d6ce15-fb1b-4041-bc21-e76275e1c685")); // One day this GUId will be dynamic
        // Validation goes here..

        var basicMonthDates = GetAllBasicMonthDatesFromSystem (2025, 2);

        foreach (var date in monthResponse!.Dates!)
        {
            var monthDate = basicMonthDates.SingleOrDefault(basicMonthDate => basicMonthDate.DateOrder! == date.DateOrder!);
            // Validation goes here to check for null. If there's a null then something terrible has happened with the data..

            monthDate = (Date) date;
            monthDate.DonutChartData = CountBoardTypes(monthDate.Cards);
            monthDate.LineChartData = GetBoardTypeData(monthDate.Cards);
            monthDate.Labels = new string [] { };//todo..
            monthDate.xAxisLabels = new string [] { };//todo..
        }

        // Fill in the surrounding dates from other months so the calendar grid can render correctly
        
        // Then validate

        _monthDates = basicMonthDates.AsEnumerable ();
    }
}