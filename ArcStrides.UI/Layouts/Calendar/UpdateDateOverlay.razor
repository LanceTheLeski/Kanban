@using ArcStrides.Contracts.Response
@using ArcStrides.UI.Components
@using ArcStrides.UI.Components.ArcOverlay
@using ArcStrides.UI.Layouts.Board.Task
@using ArcStrides.UI.Models.Board
@using ArcStrides.UI.Models.Calendar
@using Microsoft.Extensions.Options

@inject HttpClient http

@inherits LayoutComponentBase

<ArcOverlay @bind-Open="Open">
    <MudPaper Width="300px" Height="300px">
        <MudText>@($"{Date.Month} {Date.DateOrder}th {Date.Year}")</MudText>


        <MudExpansionPanels>
            <MudExpansionPanel Text="Column" MaxHeight="1000" ExpandedChanged="TaskTypeListExpandedChanged">
                @_taskTypeList
            </MudExpansionPanel>
        </MudExpansionPanels>

        <MudPaper Class="d-inline-flex flex-grow-1 overflow-auto" Style="width: 300px; height: 200px;">
            <MudStack Class="flex-grow-1" 
                      Style="width: 100%; height: 100%">
                <MudList T="string" ReadOnly="false">
                    @if (Date.Cards is not null)
                    {
                        @foreach (var card in Date.Cards)
                        {
                            <MudListItem OnClick="(() => ExpandTaskView(card))">
                                Task Name: @(card.Title)
                            </MudListItem>
                        }
                    }
                </MudList>
            </MudStack>
        </MudPaper>

        <MudPaper>
            <MudButton OnClick="ExpandCreateNewTaskView">
                Add New Task
            </MudButton>
        </MudPaper>
    </MudPaper>
</ArcOverlay>

<!--<UpdateTaskPopover @bind-Open="_taskViewIsOpen"
                   @bind-TaskData="@(_cardToView.Tasks.ToList() [0])"
                   Refresh="Refresh" />-->

<!--<UpdateTaskOverlay @bind-Open="_addTaskIsOpen"
                    Refresh="Refresh" />-->

@code 
{
    [Parameter]
    public bool Open { get; set; }
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public Date Date { get; set; }
    [Parameter]
    public EventCallback<Date> DateChanged { get; set; }

    [Parameter]
    public EventCallback<bool> Refresh { get; set; }

    private static bool _taskViewIsOpen = false;
    private static bool _addTaskIsOpen = false;
    private static Card _cardToView = null;
    private static Guid _boardIdToFilter = Guid.Empty;

    private RenderFragment _taskTypeList;
    private async System.Threading.Tasks.Task TaskTypeListExpandedChanged (bool showTasks)
    {
        //_columns = Columns;
        //_columnTitles = ColumnTitles;

        if (showTasks)
        {
            _taskTypeList = _taskTypeListRenderFragment ();
        }
        else
        {
            // Reset after a while to prevent sudden collapse.
            System.Threading.Tasks.Task.Delay (350).ContinueWith (t => _taskTypeList = null);
        }
    }

    private RenderFragment _taskTypeListRenderFragment ()
    {
        var boardIDs = Date.Cards?.Select(card => card.BoardID)
                                  .Distinct()
                                  .ToList() ?? new List<Guid> { };

        return __builder =>
        {
            <MudPaper Class="d-inline-flex flex-grow-1 overflow-auto" Style="width: 300px; height: 200px;">
                <MudStack Class="flex-grow-1" Width="100%" Height="100%">
                    <MudList T="string" ReadOnly="false">
                        <MudListItem>
                            ALL
                        </MudListItem>
                        @foreach (var boardID in boardIDs)
                        {
                            <MudListItem OnClick="(() => ChooseTaskTypeToFilter(boardID))">
                                Task Type Name: @(boardID.ToString ())
                            </MudListItem>
                        }
                    </MudList>
                </MudStack>
            </MudPaper>
        };
    }

    private static void ChooseTaskTypeToFilter (Guid boardID)
    {
        _boardIdToFilter = boardID;
    }

    private static async System.Threading.Tasks.Task ExpandTaskView (Card card)
    {
        _cardToView = card;
        _taskViewIsOpen = true;
    }

    private static async System.Threading.Tasks.Task ExpandCreateNewTaskView ()
    {
        _addTaskIsOpen = true;
    }

    private void CloseDateOverlay ()
    {
        Open = false;
        OpenChanged.InvokeAsync (Open);
    }
}