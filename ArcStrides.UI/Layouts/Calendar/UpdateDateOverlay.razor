@using ArcStrides.Contracts.Response
@using ArcStrides.UI.Components
@using ArcStrides.UI.Components.ArcOverlay
@using ArcStrides.UI.Layouts.Board.Task
@using ArcStrides.UI.Models
@using Microsoft.Extensions.Options

@inject HttpClient http

@inherits LayoutComponentBase

<ArcOverlay @bind-Open="Open">
    <MudText>@(Date.DateOrder)</MudText>
    <MudExpansionPanels>
        <MudExpansionPanel Text="Column" MaxHeight="1000" ExpandedChanged="TaskTypeListExpandedChanged">
            @_taskTypeList
        </MudExpansionPanel>
    </MudExpansionPanels>

    <MudPaper Class="d-inline-flex flex-grow-1 overflow-auto" Style="width: 300px; height: 200px;">
        <MudStack Class="flex-grow-1" Width="100%" Height="100%">
            <MudList T="string" ReadOnly="false">
                @if (Date.Cards is not null)
                {
                    @foreach (var task in Date.Cards)
                    {
                        <MudListItem OnClick="(() => ExpandTaskView(task))">
                            Task Name: @(task.Title)
                        </MudListItem>
                    }
                }
            </MudList>
        </MudStack>
    </MudPaper>

    <MudPaper>
        <MudButton OnClick="ExpandCreateNewTaskView">
            Add New Task
        </MudButton>
    </MudPaper>

</ArcOverlay>

<UpdateTaskOverlay @bind-Open="_taskViewIsOpen"
                   @bind-TaskData="@(_cardToView.Tasks.ToList() [0])"
                   Refresh="Refresh" />

<MudOverlay @bind-Visible="_addTaskIsOpen" DarkBackground="true" ZIndex="20">
    <CreateTaskOverlay @bind-Open="_addTaskIsOpen"
                       Refresh="Refresh" />
</MudOverlay>

@code 
{
    [Parameter]
    public bool Open { get; set; }
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public Date Date { get; set; }
    [Parameter]
    public EventCallback<Date> DateChanged { get; set; }

    [Parameter]
    public EventCallback<bool> Refresh { get; set; }

    private static bool _taskViewIsOpen = false;
    private static bool _addTaskIsOpen = false;
    private static CardResponse _cardToView = null;
    private static Guid _boardIdToFilter = Guid.Empty;

    private RenderFragment _taskTypeList;
    private async Task TaskTypeListExpandedChanged (bool showTasks)
    {
        //_columns = Columns;
        //_columnTitles = ColumnTitles;

        if (showTasks)
        {
            _taskTypeList = _taskTypeListRenderFragment ();
        }
        else
        {
            // Reset after a while to prevent sudden collapse.
            Task.Delay (350).ContinueWith (t => _taskTypeList = null);
        }
    }

    private RenderFragment _taskTypeListRenderFragment ()
    {
        var boardIDs = Date.Cards?.Select(card => card.Position.BoardID)
                                  .Distinct()
                                  .ToList() ?? new List<Guid?> { };

        return __builder =>
        {
            <MudPaper Class="d-inline-flex flex-grow-1 overflow-auto" Style="width: 300px; height: 200px;">
                <MudStack Class="flex-grow-1" Width="100%" Height="100%">
                    <MudList T="string" ReadOnly="false">
                        <MudListItem>
                            ALL
                        </MudListItem>
                        @foreach (var boardID in boardIDs)
                        {
                            <MudListItem OnClick="(() => ChooseTaskTypeToFilter(boardID.Value))">
                                Task Type Name: @(boardID.ToString ())
                            </MudListItem>
                        }
                    </MudList>
                </MudStack>
            </MudPaper>
        };
    }
    private static void ChooseTaskTypeToFilter (Guid boardID)
    {
        _boardIdToFilter = boardID;
    }

    private static async Task ExpandTaskView (CardResponse card)
    {
        _cardToView = card;
        _taskViewIsOpen = true;
    }

    private static async Task ExpandCreateNewTaskView ()
    {
        _addTaskIsOpen = true;
    }

    private void CloseDateOverlay ()
    {
        Open = false;
        OpenChanged.InvokeAsync (Open);
    }
}