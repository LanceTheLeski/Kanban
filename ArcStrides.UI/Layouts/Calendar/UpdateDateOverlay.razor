@using ArcStrides.Contracts.Response
@using ArcStrides.UI.Components
@using ArcStrides.UI.Components.ArcExpandingSelector
@using ArcStrides.UI.Components.ArcOverlay
@using ArcStrides.UI.Layouts.Board
@using ArcStrides.UI.Layouts.Board.Task
@using ArcStrides.UI.Models.Board
@using ArcStrides.UI.Models.Calendar
@using Microsoft.Extensions.Options

@inject HttpClient http

@inherits LayoutComponentBase

<ArcOverlay @bind-Open="Open">
    <MudPaper Width="950px"
              Height="650px"
              Elevation="0">
        <MudGrid Style="height: 100%; background-color: pink;"
                 Class="flex-row-reverse object-fill mud-width-full"
                 Spacing="0">
            <MudItem Style="height: 100%">
                <MudStack>
                    <CalendarDate @bind-Date="Date" />
                    @foreach (var card in Date.Cards ?? [])
                    {
                        <MudPaper>@card.Title</MudPaper>
                    }
                </MudStack>
            </MudItem>
            <MudItem Style="height: 100%" 
                     Class="flex-grow-1">
                <MudPaper Class="glass-frosted" Width="100%">
                    <MudStack Spacing="0">
                        <MudPaper Width="100%">
                            <MudGrid Spacing="0"
                                     Style="height: 80px;">
                                <MudItem>
                                    <MudText Style="font: 'EB Garamond';
                                                    font-size: 30px;
                                                    height: 100%">@($"{Date.Month} {Date.DateOrder}th {Date.Year}")</MudText><!--Good date font + Larger-->
                                </MudItem>
                                <MudItem>
                                    <ArcExpandingSelector @bind-Options='_dateTypeList'
                                                          OptionSelected="@((dateTypeSelected) => _dateTypeSelected = int.Parse(dateTypeSelected))" />
                                </MudItem>
                                <MudItem>
                                    <MudListItem T="string"
                                                 Gutters="false" 
                                                 Dense="false"><!--OnClick should activate pallette picker..-->
                                        <MudPaper Style="background: 
                                                            radial-gradient(ellipse at top, #e66465, #0022bb),
                                                            radial-gradient(ellipse at bottom, #4d9f0c, #0022bb);"
                                                  Height="50px"
                                                  Width="50px">
                                        </MudPaper>
                                    </MudListItem>
                                </MudItem>
                                <MudItem>
                                    <MudPaper>
                                        Tag Canvas Placeholder :)
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <MudPaper MaxWidth="100%">
                            <MudGrid Spacing="0">
                                <MudItem>
                                    <MudPaper MaxHeight="400px" Style="overflow: scroll">
                                        <MudTimeline Style="width: 300px;">
                                            <MudTimelineItem Size="Size.Small">
                                                @foreach (var task in (Date.Cards?.SelectMany(card => card.Tasks.Where (task => task.Timeline is not null)) ?? [])
                                                                                  .OrderBy(task => task.Timeline!.EndDeadlineUTC))
                                                {
                                                    <MudText Style="font-weight: 700; 
                                                                    font-size: small;" 
                                                             Align="Align.Left" 
                                                             GutterBottom="false">
                                                        @(task.Timeline!.EndDeadlineUTC.ToString()): @(task.Title)
                                                    </MudText>
                                                }
                                            </MudTimelineItem>
                                        </MudTimeline>
                                    </MudPaper>
                                </MudItem>
                                <MudItem>
                                    <MudPaper MaxHeight="400px" Style="overflow: scroll">
                                        <MudTimeline Style="width: 300px;">
                                            <MudTimelineItem Size="Size.Small">
                                                <MudText>Event 1</MudText>
                                            </MudTimelineItem>
                                            <MudTimelineItem Size="Size.Small">
                                                <MudText>Event 2</MudText>
                                            </MudTimelineItem>
                                            <MudTimelineItem Size="Size.Small">
                                                <MudText>Event 3</MudText>
                                            </MudTimelineItem>
                                            <MudTimelineItem Size="Size.Small">
                                                <MudText>Event 4</MudText>
                                            </MudTimelineItem>
                                            <MudTimelineItem Size="Size.Small">
                                                <MudText>Event 5</MudText>
                                            </MudTimelineItem>
                                            <MudTimelineItem Size="Size.Small">
                                                <MudText>Event 6</MudText>
                                            </MudTimelineItem>
                                        </MudTimeline>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <!--Not sure abour below section-->
                        <!--<MudPaper Class="d-inline-flex flex-grow-1 overflow-auto" Style="width: 300px; height: 200px;">
                            <MudStack Class="flex-grow-1" 
                                      Style="width: 100%; height: 100%">
                                <MudList T="string" ReadOnly="false">
                                    @if (Date.Cards is not null)
                                    {
                                        @foreach (var card in Date.Cards)
                                        {
                                            //<MudListItem OnClick="(() => ExpandTaskView(card))">
                                            //    Task Name: @(card.Title)
                                            //</MudListItem>
                                        }
                                    }
                                </MudList>
                            </MudStack>
                        </MudPaper>-->
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>
</ArcOverlay>

