@code
{
    private string _backgroundUrl = "DefaultBackground5.jpg";

    protected override void OnInitialized ()
    {
        // initial set
        UpdateBackground (NavigationManager.Uri);

        // watch for every navigation
        NavigationManager.LocationChanged += (_, args) =>
        {
            UpdateBackground (args.Location);
            StateHasChanged ();
        };
    }

    private void UpdateBackground (string absoluteUri)
    {
        // turn "https://.../dashboard?foo=bar" into "dashboard"
        var relative = NavigationManager.ToBaseRelativePath (absoluteUri)
                                        //.Split ('?', StringSplitOptions.RemoveEmptyEntries) [0]
                                        .TrimEnd ('/');

        // map the route to your image
        _backgroundUrl = relative switch
        {
            "" or "/" => "DefaultBackground5.jpg",
            "board" => "DefaultBackground5.jpg",
            "calendar" => "CalendarBackground3.jpg",//Maybe 1 is better?
            // add more routes here...
            _ => "/images/DefaultBackground5.jpg"
        };
    }
}