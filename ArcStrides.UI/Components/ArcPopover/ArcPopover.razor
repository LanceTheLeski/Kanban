@rendermode RenderMode.InteractiveServer

@inherits LayoutComponentBase

<div>
    <MudButton OnClick="@(() => Open = true)"
               Class="glass"
               Style="@PopoverBaseMudStyle"
               Size="@PopoverBaseMudSize">
        @PopoverBaseText
    </MudButton>

    <MudPopover Open="Open"
                OverflowBehavior="OverflowBehavior.FlipAlways"
                AnchorOrigin="Origin.CenterRight"
                TransformOrigin="Origin.CenterLeft"
                Style="height:550px">

        @ChildContent

        <MudButtonGroup Class="glass-inner-engraved">
            @if (OnSubmit is not null)
            {
                <MudButton OnClick="OnSubmit.Value">Submit</MudButton>
            }
            @if (OnSubmitAsync is not null)
            {
                <MudButton OnClick="OnSubmitAsync.Invoke">Submit</MudButton>
            }
            <MudButton OnClick="CloseOverlay">Discard</MudButton>
        </MudButtonGroup>
    </MudPopover>
</div>

@code
{
    [Parameter]
    public bool Open { get; set; } = false;
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public string PopoverBaseText { get; set; } = string.Empty;

    [Parameter]
    public string PopoverBaseMudStyle { get; set; } = string.Empty;

    [Parameter]
    public Size PopoverBaseMudSize { get; set; } = Size.Medium;

    //[Parameter]
    //public RendarFragment? PopoverFragment { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; } = null;

    [Parameter]
    public EventCallback? OnSubmit { get; set; } = null;

    [Parameter]
    public Func<Task>? OnSubmitAsync { get; set; } = null;
}