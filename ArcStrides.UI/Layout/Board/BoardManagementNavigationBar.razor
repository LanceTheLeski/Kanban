@using ArcStrides.UI.Components
@using ArcStrides.UI.Layout.Board
@using ArcStrides.UI.Layout.Card
@using ArcStrides.UI.Layout.Column
@using ArcStrides.UI.Layout.Swimlane
@using ArcStrides.UI.Models

@rendermode RenderMode.InteractiveServer

@inherits LayoutComponentBase

<MudThemeProvider Theme="@MyMudThemeProvider._ArcBoardDefaultTheme" />

<MudPaper Elevation="25" Class="d-inline justify-center mud-theme-primary">
    <MudToolBar Class="mud-theme-primary justify-left">
        <MudPaper Elevation="0" Class="mud-theme-primary">
            <MudImage Width="30" Height="30" Src="Honu.png"/>
        </MudPaper>
        <MudPaper Elevation="0" MaxWidth="150px" MaxHeight="30px" Style="padding-left:40px; padding-right:40px;" Class="mud-theme-primary">
            <MudMenu Label="Cards" TransformOrigin="Origin.TopCenter" AnchorOrigin="Origin.BottomCenter">
                <MudMenuItem OnClick="createCardOverlay.OpenOverlay">Add</MudMenuItem>
            </MudMenu>
        </MudPaper>
        <MudPaper Elevation="0" MaxWidth="150px" MaxHeight="30px" Style="padding-left:40px; padding-right:40px;" Class="mud-theme-primary">
            <MudMenu Label="Swimlanes" TransformOrigin="Origin.TopCenter" AnchorOrigin="Origin.BottomCenter">
                <MudMenuItem OnClick="createSwimlaneOverlay.OpenOverlay">Add</MudMenuItem>
                <MudMenuItem OnClick="updateSwimlaneOverlay.OpenOverlay">Edit</MudMenuItem>
                <MudMenuItem OnClick="deleteSwimlaneOverlay.OpenOverlay">Delete</MudMenuItem>
            </MudMenu>
        </MudPaper>
        <MudPaper Elevation="0" MaxWidth="150px" MaxHeight="30px" Style="padding-left:40px; padding-right:40px;" Class="mud-theme-primary">
            <MudMenu Label="Columns" TransformOrigin="Origin.TopCenter" AnchorOrigin="Origin.BottomCenter">
                <MudMenuItem OnClick="createColumnOverlay.OpenOverlay">Add</MudMenuItem>
                <MudMenuItem OnClick="updateColumnOverlay.OpenOverlay">Edit</MudMenuItem>
                <MudMenuItem OnClick="deleteColumnOverlay.OpenOverlay">Delete</MudMenuItem>
            </MudMenu>
        </MudPaper>
        <MudPaper Elevation="0" MaxWidth="150px" MaxHeight="30px" Style="padding-left:40px; padding-right:40px;" Class="mud-theme-primary">
            <MudMenu Label="Boards" TransformOrigin="Origin.TopCenter" AnchorOrigin="Origin.BottomCenter">
                <MudMenuItem OnClick="addManageBoardOverlay.OpenOverlay">Edit</MudMenuItem>
            </MudMenu>
        </MudPaper>
    </MudToolBar>
</MudPaper>

<CreateCardOverlay @ref="createCardOverlay"
                   @bind-Cards="Cards"
                   @bind-Columns="Columns"
                   @bind-ColumnTitles="ColumnTitles"
                   @bind-Swimlanes="Swimlanes"
                   @bind-SwimlaneTitles="SwimlaneTitles"
                   Refresh="Refresh" />

<CreateSwimlaneOverlay @ref="createSwimlaneOverlay"
                       @bind-Swimlanes="Swimlanes"
                       @bind-SwimlaneTitles="SwimlaneTitles" 
                       Refresh="Refresh" />

<DeleteSwimlaneOverlay @ref="deleteSwimlaneOverlay" 
                       @bind-Swimlanes="Swimlanes"
                       @bind-SwimlaneTitles="SwimlaneTitles" 
                       Refresh="Refresh" />

<UpdateSwimlaneOverlay @ref="updateSwimlaneOverlay"
                       @bind-Swimlanes="Swimlanes"
                       @bind-SwimlaneTitles="SwimlaneTitles" 
                       Refresh="Refresh" />

<CreateColumnOverlay @ref="createColumnOverlay"
                     @bind-Columns="Columns"
                     @bind-ColumnTitles="ColumnTitles" 
                     Refresh="Refresh" />

<DeleteColumnOverlay @ref="deleteColumnOverlay"
                     @bind-Columns="Columns"
                     @bind-ColumnTitles="ColumnTitles" 
                     Refresh="Refresh" />

<UpdateColumnOverlay @ref="updateColumnOverlay"
                     @bind-Columns="Columns"
                     @bind-ColumnTitles="ColumnTitles" 
                     Refresh="Refresh" />

<AddManageBoardOverlay @ref="addManageBoardOverlay" />

@code 
{
    [Parameter]
    public List<DropCard>? Cards { get; set; }
    [Parameter]
    public EventCallback<List<DropCard>> CardsChanged { get; set; }

    [Parameter]
    public List<string>? SwimlaneTitles { get; set; }
    [Parameter]
    public EventCallback<List<string>> SwimlaneTitlesChanged { get; set; }

    [Parameter]
    public List<Guid>? Swimlanes { get; set; }
    [Parameter]
    public EventCallback<List<Guid>> SwimlanesChanged { get; set; }

    [Parameter]
    public List<string>? ColumnTitles { get; set; }
    [Parameter]
    public EventCallback<List<string>> ColumnTitlesChanged { get; set; }

    [Parameter]
    public List<Guid>? Columns { get; set; }
    [Parameter]
    public EventCallback<List<Guid>> ColumnsChanged { get; set; }

    [Parameter]
    public EventCallback<bool> Refresh { get; set; }

    private CreateCardOverlay createCardOverlay = new CreateCardOverlay ();

    private CreateSwimlaneOverlay createSwimlaneOverlay = new CreateSwimlaneOverlay ();
    private DeleteSwimlaneOverlay deleteSwimlaneOverlay = new DeleteSwimlaneOverlay ();
    private UpdateSwimlaneOverlay updateSwimlaneOverlay = new UpdateSwimlaneOverlay ();

    private CreateColumnOverlay createColumnOverlay = new CreateColumnOverlay ();
    private DeleteColumnOverlay deleteColumnOverlay = new DeleteColumnOverlay ();
    private UpdateColumnOverlay updateColumnOverlay = new UpdateColumnOverlay ();

    private AddManageBoardOverlay addManageBoardOverlay = new AddManageBoardOverlay ();
}