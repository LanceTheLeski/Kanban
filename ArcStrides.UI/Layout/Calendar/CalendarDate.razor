@using ArcStrides.Contracts.Response
@using ArcStrides.UI.Models
@using System.Collections.ObjectModel
@using static ArcStrides.UI.Models.Date

<MudPaper Width="200px;" 
          Height="170px">
    <MudStack Spacing="0" 
              Style="position: relative;">
        <MudPaper Style="background-color: rgba(0, 0, 0, 0); 
                         position:absolute; z-index: 1; 
                         text-align: center; 
                         padding-left: 13px; 
                         padding-top: 13px;" 
                  Elevation="0" 
                  Height="25px;">
            <MudText Align="Align.Center" Style="color: white">@(DayData.DayOfTheMonth.ToString ())</MudText>
        </MudPaper>
        <MudGrid Style="height: 50px; 
                        background-color:crimson; 
                        flex-direction: row;" 
                 Spacing="0" 
                 Justify="Justify.FlexStart">
            <MudItem Style="width: 40px;">
                <MudPaper Style="background-color: sandybrown;" 
                          Width="40px" 
                          Elevation="0">
                    <MudChart ChartType="ChartType.Donut" 
                              Width="40px" 
                              Height="50px" 
                              InputData="@DayData.DonutChartData" 
                              InputLabels="@DayData.Labels" 
                              ChartOptions="@options" 
                              Style="background-color:#c4001e;"></MudChart>
                </MudPaper>
            </MudItem>
            <MudItem Style="width: 80px">
                <MudPaper Elevation="0" 
                          Style="background-color: olive" 
                          Width="80px">
                    <MudChart ChartType="ChartType.Line" 
                              Width="80px" 
                              Height="50px" 
                              XAxisLabels="@DayData.xAxisLabels" 
                              ChartSeries="@DayData.LineChartData" 
                              ChartOptions="@options" 
                              Style="background-color:#6b052a"></MudChart>
                </MudPaper>
            </MudItem>
            <MudItem>
                <MudStack Spacing="0">   
                    <MudPaper Width="80px" Height="32px" Style="background-color: #c4001e;">
                        <MudGrid Spacing="0" Style="width: 80px; height: 32px;">
                            <MudItem Style="width: 40px; height: 20px;">
                                <MudImage Width="30" Height="32" Fluid="true" ObjectFit="ObjectFit.ScaleDown" ObjectPosition="ObjectPosition.Center" Src="icons8-menu-vertical-50.png" Style="filter: y" />
                            </MudItem>
                            <MudItem Style="width: 40px; height: 20px;">
                                <MudButton OnClick="(() => UpdateDateIsOpen())">
                                    <MudImage Width="30" Height="32" Fluid="true" ObjectFit="ObjectFit.ScaleDown" ObjectPosition="ObjectPosition.Center" Src="icons8-expand-50.png" />
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                    <MudPaper Width="80px" Height="18px">
                        <MudGrid Spacing="0" Style="height: 18px;
                                                    background-color:khaki;
                                                    flex-direction: row;">
                            <MudPaper Width="15px" Height="18px" Style="background-color:#780002" Square="true">
                                <MudListItem T="string" OnClick="@(() => DateBodyIndex -= 1)" Gutters="false" Dense="false" Style="height: 18px;">
                                    <MudImage Width="15" Height="18" Fluid="true" ObjectFit="ObjectFit.ScaleDown" Src="icons8-left-arrow-50.png" />
                                </MudListItem>
                            </MudPaper>
                            <MudPaper Width="50px" Height="18px" Style="background-color:green;" Square="true">
                                <MudListItem T="string" OnClick="@(() => Cycle = !Cycle)" Gutters="false" Dense="false" Style="height: 18px;">
                                    <MudText Align="Align.Center" Style="height: 18px; font-weight:600; font-family: 'Times New Roman', Times, serif; color: white;">ALL</MudText>
                                </MudListItem>
                            </MudPaper>
                            <MudPaper Width="15px" Height="18px" Style="background-color:#780002" Square="true">
                                <MudListItem T="string" OnClick="@(() => DateBodyIndex += 1)" Gutters="false" Dense="false" Style="height: 18px;">
                                    <MudImage Width="15" Height="18" Fluid="true" ObjectFit="ObjectFit.ScaleDown" Src="icons8-right-arrow-50.png" />
                                </MudListItem>
                            </MudPaper>
                        </MudGrid>
                    </MudPaper>
                </MudStack>
            </MudItem>
        </MudGrid>
        <MudCarousel TData="object" ShowArrows="false" ShowBullets="false" AutoCycle="@Cycle" SelectedIndex="@DateBodyIndex" Style="height: 120px;">
            @foreach (var boardID in DayData.Cards.Select (card => card.BoardID).Distinct ())
            {
                <MudCarouselItem Class="overflow-hidden overflow-y-scroll">
                    @foreach (var card in DayData.Cards.Where (card => card.BoardID == boardID).Take (3).ToList ())
                    {
                        <MudPaper>
                            <MudText Style="font-size: x-small">@card.Title</MudText>
                            @foreach (var task in card.Tasks.Take (3).ToList ())
                            {
                                <MudPaper Width="90%" Style="background-color: greenyellow;">
                                    <MudText Style="font-size: small">@task.Title</MudText>
                                </MudPaper>
                            }
                        </MudPaper>
                    }
                </MudCarouselItem>
            }
        </MudCarousel>
    </MudStack>
</MudPaper>

<MudOverlay @bind-Visible="open" DarkBackground="true" ZIndex="10">
    <UpdateDateOverlay @bind-Open="open"
                       @bind-DayData="DayData" />
</MudOverlay>

@code 
{
    [Parameter]
    public Day DayData { get; set; }
    [Parameter]
    public EventCallback<Day> DayDataChanged { get; set; }

    private bool open = false;
    private void UpdateDateIsOpen()
    {
        open = true;
    }

    private ChartOptions options = new ChartOptions
    {
        ShowLegend = false,
        YAxisTicks = 7,
        LineStrokeWidth = 10
    };

    private bool Cycle = true;
    private int DateBodyIndex = 0;
}