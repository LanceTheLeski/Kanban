@using ArcStrides.UI

@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page mud-layout"
     style="background-image: url('DefaultBackground5.jpg')"><!--So far 3 is best-->
