@using ArcStrides.Contracts.Response
@using ArcStrides.UI.Components
@using ArcStrides.UI.Components.ArcExpandingSelector
@using ArcStrides.UI.Components.ArcOverlay
@using ArcStrides.UI.Components.ArcPopover
@using ArcStrides.UI.Layouts.Board.Timeline
@using ArcStrides.UI.Layouts.TagGroup.TaskType;
@using ArcStrides.UI.Models.Board
@using ArcStrides.UI.Repositories

<ArcPopover PopoverBaseText="@ActiveTask!.Title"
            OnSubmitAsync="UpdateTaskAsync"
            PopoverBaseMudSize="@PopoverBaseMudSize"
            PopoverBaseMudStyle="@PopoverBaseMudStyle"
            PopoverBaseMudTextStyle="@PopoverBaseMudTextStyle">
    <MudPaper Style="background-color: transparent;"
              Width="600px">
        <MudTextField @bind-Value="ActiveTask!.Title" T="string" Label="Title" Variant="Variant.Filled" HelperText="Task Title" />

        <MudGrid>
            <MudItem>
                <ArcExpandingSelector Options="new List<string> {bool.TrueString, bool.FalseString}"
                                      OptionSelected="((string selection) => _initialIsCompleted = bool.Parse (selection))" />
                <ArcExpandingSelector Options="_taskOrderRange"
                                      OptionSelected="SetTaskOrderOnTask" />
                <ArcExpandingSelector Options="_taskTypes.Select (taskType => taskType!.Title!).ToList ()"
                                      OptionSelected="SetTaskTypeOnTask" />
                <MudButton OnClick="@(createTaskTypeOverlay.OpenOverlay)">Create New Task Type</MudButton>
            </MudItem>
            <MudItem>
                <UpdateTimelinePanel BoardID="BoardID" 
                                     @bind-Timeline="ActiveTask!.Timeline" 
                                     @ref="updateTimelinePanel" />
            </MudItem>
        </MudGrid>
    </MudPaper>
</ArcPopover>

<CreateTaskTypeOverlay @ref="createTaskTypeOverlay"
                       Refresh="Refresh" /><!---This works now!!!! But I suspect it might be best to make it an edit screen where we can delete, update, and add TaskTypes--->

@inject ITaskRepository _taskRepository;

@inject ITimelineRepository _timelineRepository;

@code
{
    private bool tempOpen = false;

    [Parameter]
    public Models.Board.Task? ActiveTask { get; set; }
    [Parameter]
    public EventCallback<Models.Board.Task?> ActiveTaskChanged { get; set; }

    [Parameter]
    public int TasksCount { get; set; }
    //[Parameter]
    //public EventCallback<int> TaskCountsChanged { get; set; }

    [Parameter]
    public Guid? CardID { get; set; }
    [Parameter]
    public EventCallback<Guid?> CardIDChanged { get; set; }

    [Parameter]
    public Guid BoardID { get; set; }
    [Parameter]
    public EventCallback<Guid> BoardIDChanged { get; set; }

    [Parameter]
    public Size PopoverBaseMudSize { get; set; } = Size.Medium;

    [Parameter]
    public string PopoverBaseMudStyle { get; set; } = string.Empty;

    [Parameter]
    public string PopoverBaseMudTextStyle { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<bool> Refresh { get; set; }

    // I think all of the below fields can be removed soon. We should ideally just use the ActiveTask instead.
    private string _initialTaskTitle = string.Empty;
    private int _initialTaskTypeId = 0;
    private int _initialTaskOrder = -1;
    private Timeline? _initialTimeline = null;
    private bool? _initialIsCompleted = null;

    private List<string> _taskOrderRange = new List<string> ();

    private List<TaskTypeResponse> _taskTypes = new List<TaskTypeResponse> ();

    //On page load. Not async to this layout class loading.
    protected override void OnInitialized ()
    {
        if (ActiveTask is null)
        {
            ActiveTask = new Models.Board.Task
            {
                ID = Guid.Empty,
                Title = "TempTitle (FIX)",
                Order = -1,
                TaskType = new TaskType { ID = -1, GroupTagID = Guid.Empty, Title = "TempTitle (FIX here too)" },
                IsCompleted = null,
                Timeline = null
            };
        }

        _initialTaskTypeId = ActiveTask?.TaskType?.ID ?? -1;
        _initialTaskOrder = ActiveTask?.Order ?? -1;
        _initialTimeline = ActiveTask?.Timeline;
        _initialIsCompleted = ActiveTask?.IsCompleted;

        _taskOrderRange = new List<string>();
        for (int index = 1; index <= TasksCount; index ++)
            _taskOrderRange.Add(index.ToString());
    }

    protected async override System.Threading.Tasks.Task OnAfterRenderAsync (bool firstRender)
    {
        if (firstRender)
        {
            _taskTypes = await FetchTaskTypesAsync ();
        }
    }

    private UpdateTimelinePanel updateTimelinePanel;

    private CreateTaskTypeOverlay createTaskTypeOverlay;
}