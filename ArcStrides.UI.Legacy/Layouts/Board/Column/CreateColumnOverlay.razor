@using ArcStrides.Contracts.Request.Create
@using ArcStrides.Contracts.Response
@using ArcStrides.UI.Components
@using ArcStrides.UI.Components.ArcOverlay
@using ArcStrides.UI.Models
@using ArcStrides.UI.Options
@using ArcStrides.UI.Repositories
@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using System.Net.Http.Headers

@rendermode RenderMode.InteractiveServer

<ArcOverlay @bind-Open="Open"
            OnSubmitAsync="CreateColumnAsync">

    <MudText>Add a New Column</MudText>

    <MudTextField T="string" 
                  @bind-Value="_columnTitle" 
                  Label="Title" 
                  Variant="Variant.Filled" 
                  AutoGrow HelperText="Column Title" />

    <MudTextField T="string" 
                  @bind-Value="_columnOrder" 
                  Label="Order" 
                  Variant="Variant.Filled" 
                  AutoGrow HelperText="Column Order" />

</ArcOverlay>

@inject IColumnRepository _columnRepository

@code 
{
    [Parameter]
    public bool Open { get; set; }
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public Guid BoardID { get; set; }
    [Parameter]
    public EventCallback<Guid> BoardIDChanged { get; set; }

    [Parameter]
    public List<Guid> Columns { get; set; }
    [Parameter]
    public EventCallback<List<Guid>> ColumnsChanged { get; set; }

    [Parameter]
    public List<string> ColumnTitles { get; set; }
    [Parameter]
    public EventCallback<List<string>> ColumnTitlesChanged { get; set; }

    [Parameter]
    public EventCallback<bool> Refresh { get; set; }
    
    private string _columnTitle = string.Empty;

    private string _columnOrder = string.Empty;
}