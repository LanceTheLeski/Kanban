@using ArcStrides.UI.Components
@using ArcStrides.UI.Components.ArcExpandingSelector
@using ArcStrides.UI.Components.ArcOverlay
@using ArcStrides.UI.Options
@using ArcStrides.UI.Repositories
@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using ArcStrides.UI.Models
@using System.Net.Http.Headers

@rendermode RenderMode.InteractiveServer

<ArcOverlay @bind-Open="Open" 
            OnSubmitAsync="RemoveColumnAsync">
    
    <MudText>Edit Column</MudText>
    
    <ArcExpandingSelector @bind-Options="ColumnTitles" 
                          OptionSelected="SetColumnNameToDelete" />

</ArcOverlay>

@inject IColumnRepository _columnRepository;

@code
{
    [Parameter]
    public bool Open { get; set; }
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public Guid BoardID { get; set; }
    [Parameter]
    public EventCallback<Guid> BoardIDChanged { get; set; }

    [Parameter]
    public List<Guid> Columns { get; set; }
    [Parameter]
    public EventCallback<List<Guid>> ColumnsChanged { get; set; }

    [Parameter]
    public List<string> ColumnTitles { get; set; }
    [Parameter]
    public EventCallback<List<string>> ColumnTitlesChanged { get; set; }

    [Parameter]
    public EventCallback<bool> Refresh { get; set; }

    private string _columnTitleSelected = "";
}