@using ArcStrides.Contracts.Response
@using ArcStrides.UI.Layouts.Board.Card
@using ArcStrides.UI.Layouts.Board.Task
@using ArcStrides.UI.Models.Calendar
@using System.Collections.ObjectModel

@using static ArcStrides.UI.Models.Calendar.Date

<MudPaper Width="170px" 
          Height="170px"
          Class="glass"
          Style="padding: 0;">
    <MudStack Spacing="0"
              Style="position: relative;">
        <MudPaper Style="background-color: transparent;
                         position:absolute; 
                         z-index: 1;"
                  Elevation="0" 
                  Square=true
                  Height="50px;"
                  Width="41px;">
            <MudText Align="Align.Center"
                     class="gold-text"
                     Style="font-family: 'Modern No. 20';
                            line-height: 50px;
                            font-weight: bold">@(Date.DateOrder.ToString ())</MudText>
        </MudPaper>
        <MudGrid Style="height: 50px; 
                        flex-direction: row;" 
                    Spacing="0" 
                    Justify="Justify.FlexStart">
            <MudItem Style="width: 40px;">
                <MudPaper Width="40px" 
                          Elevation="0"
                          Square=true
                          Style="background-color: #FAB2AC;
                                 border-radius: 100%;">
                    <MudChart ChartType="ChartType.Donut" 
                              Width="40px" 
                              Height="40px" 
                              InputData="@Date.DonutChartData"
                              InputLabels="@Date.Labels"
                              ChartOptions="@options"
                              Style="background-color: #630000;
                                     border-radius: 50%;
                                     position: absolute;
                                     margin-top: 5px;">
                        <!--<CustomGraphics>
                            <text x="50%" 
                                  y="50%" 
                                  dominant-baseline="middle" 
                                  text-anchor="middle"
                                  font-size="14"
                                  class="gold-text">@(Date.DateOrder.ToString ())</text>    The class doesn't work for some reason..?
                        </CustomGraphics>-->
                    </MudChart>
                </MudPaper>
            </MudItem>
            <MudItem Style="width: 50px;
                            background-color: white">
                <MudPaper Elevation="0"
                          Square=true
                          Width="50px"
                          Style="background-color: white">
                    <MudChart ChartType="ChartType.Line" 
                                Width="50px" 
                                Height="50px" 
                                XAxisLabels="@Date.xAxisLabels"
                                ChartSeries="@Date.LineChartData"
                                ChartOptions="@options" 
                                Style="background: linear-gradient(322deg,
                                                                   rgba(134, 164, 184, 1) 0%, 
                                                                   rgba(227, 227, 227, 1) 100%);
                                       border-style: outset;
                                       border-radius: 3px;"></MudChart>
                </MudPaper>
            </MudItem>
            <MudItem>
                <MudStack Spacing="0"
                          Style="background-color: transparent">   
                    <MudPaper Width="80px" Height="32px" Style="background-color: transparent">
                        <MudGrid Spacing="0" 
                                 Style="width: 80px;
                                        height: 32px;">
                            <MudItem Style="text-align: center;
                                            width: 40px; 
                                            height: 32px;">
                                <MudImage Width="30" 
                                          Height="32" 
                                          Fluid="true" 
                                          ObjectFit="ObjectFit.ScaleDown" 
                                          ObjectPosition="ObjectPosition.Center" 
                                          Src="icons8-menu-vertical-50.png"
                                          Alt="Date Settings"/>
                            </MudItem>
                            <MudItem Style="width: 40px;
                                            height: 32px;">
                                <MudListItem T="object"
                                             OnClick="(() => openDateOverlay = true)"
                                             Gutters="false"
                                             Dense="false"
                                             Style="text-align: center;
                                                    height: 32px;
                                                    width: 40px;
                                                    padding-top: 15px;">
                                    <MudImage Width="30" 
                                                Height="32" 
                                                Fluid="true" 
                                                ObjectFit="ObjectFit.ScaleDown" 
                                                ObjectPosition="ObjectPosition.Center" 
                                                Src="icons8-expand-50.png"
                                                Alt="Expand Date"/>
                                </MudListItem>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                    <MudPaper Width="80px" Height="18px" Style="background-color: transparent">
                        <MudGrid Spacing="0" Style="height: 18px;
                                                    flex-direction: row;">
                            <MudPaper Width="15px" Height="18px" Class="glass-inner-engraved" Square="true">
                                <MudListItem T="string" 
                                             OnClick="@(() => moveLeft(DateBodyIndex))" 
                                             Gutters="false" 
                                             Dense="false" 
                                             Style="height: 18px; background-color: transparent">
                                    <MudImage Width="15" 
                                              Height="18" 
                                              Fluid="true" 
                                              ObjectFit="ObjectFit.ScaleDown" 
                                              Src="icons8-left-arrow-50.png" 
                                              Style="background-color: transparent" />
                                </MudListItem>
                            </MudPaper>
                            <MudPaper Width="50px" Height="18px" Style="background-color: #630000;" Square="true">
                                <MudListItem T="string" OnClick="@(() => Cycle = !Cycle)" Gutters="false" Dense="false" Style="height: 18px;">
                                    <MudText Align="Align.Center" 
                                             class="gold-text"
                                             Style="height: 18px; 
                                                    font-weight:600; 
                                                    font-family: 'Times New Roman', Times, serif;">
                                                        ALL
                                    </MudText>
                                </MudListItem>
                            </MudPaper>
                            <MudPaper Width="15px" Height="18px" Class="glass-inner-engraved" Square="true">
                                <MudListItem T="string" 
                                             OnClick="@(() => moveRight(DateBodyIndex))" 
                                             Gutters="false" 
                                             Dense="false" 
                                             Style="height: 18px;">
                                    <MudImage Width="15" 
                                              Height="18" 
                                              Fluid="true" 
                                              ObjectFit="ObjectFit.ScaleDown" 
                                              Src="icons8-right-arrow-50.png" />
                                </MudListItem>
                            </MudPaper>
                        </MudGrid>
                    </MudPaper>
                </MudStack>
            </MudItem>
        </MudGrid>
        <MudPaper Class="glass-frosted"
                  Style="padding-top: 0px;
                         padding-bottom: 5px;
                         padding-left: 2px;
                         padding-right: 2px;"
                  Width="100%"
                  Square=true>
            <MudCarousel TData="object" 
                         ShowArrows="false" 
                         ShowBullets="false" 
                         AutoCycle="@Cycle"
                         SelectedIndex="@DateBodyIndex"
                         Style="height: 120px;
                                width: 100%;">
                @if (Date.Cards is not null)
                {
                    @foreach (var boardID in Date.Cards.Select (card => card.BoardID).Distinct ())
                    {
                        <MudCarouselItem Class="overflow-hidden overflow-y-scroll">
                            @foreach (var card in Date.Cards.Where (card => card.BoardID == boardID).Take (3).ToList ())
                            {
                                <MudPaper Width="100%"
                                          Style="background-color: #0F83DB;
                                                 color: #E0E8EF;
                                                 margin-bottom: 2px;">
                                    <MudListItem T="string"
                                                 OnClick="@(() => 
                                                            {
                                                                ActiveCard = card;
                                                                openCardOverlay = true;
                                                            })"
                                                 Dense="true"
                                                 Gutters="false">

                                        <MudText Style="font-size: x-small;
                                                        padding-left: 10px;
                                                        padding-right: 10px;">
                                            @card.Title
                                        </MudText>

                                        @foreach (var taskIndex in Enumerable.Range(0, card.Tasks.Count()))
                                        {
                                            <MudPaper Width="98%" Style="background-color: #FEECA5;
                                                                         justify-self: center;
                                                                         margin-bottom: 1px;
                                                                         margin-top: 1px;">

                                                <UpdateTaskPopover @bind-ActiveTask="card.Tasks[taskIndex]"
                                                                   CardID="card.Id"
                                                                   BoardID="card.BoardID"
                                                                   TasksCount="card.Tasks.Count()"
                                                                   PopoverBaseMudSize="Size.Small"
                                                                   PopoverBaseMudStyle="padding-left: 2px;
                                                                                        padding-right: 2px;
                                                                                        max-height: 25px;
                                                                                        width: 100%;
                                                                                        font-size: xx-small;
                                                                                        font-weight: 600;
                                                                                        text-align: left;
                                                                                        line-height: 7px;
                                                                                        justify-content: flex-start;" />

                                            </MudPaper>
                                        }
                                    </MudListItem>
                                </MudPaper>
                            }
                        </MudCarouselItem>
                    }
                }
            </MudCarousel>
        </MudPaper>
    </MudStack>
</MudPaper>

<UpdateCardOverlay @bind-Open="openCardOverlay"
                   @bind-ActiveCard="ActiveCard"
                   @bind-BoardID="ActiveCard.BoardID"/>

<UpdateDateOverlay @bind-Open="openDateOverlay"
                   @bind-Date="Date"/>

@code 
{
    [Parameter]
    public Date Date { get; set; }
    [Parameter]
    public EventCallback<Date> DateChanged { get; set; }

    private ChartOptions options = new ChartOptions ()
    {
        ShowLegend = false,
        YAxisTicks = 2,
        LineStrokeWidth = 38,
        ChartPalette = ["#3B7A2B", "#ED9D26", "#FFA6EE", "#946CBA"]
    };

    private Models.Board.Card ActiveCard = new Models.Board.Card
    {
        Id = Guid.Empty,
        Title = "[Placeholder Title]",
        Description = "[Placeholder Description]"
    };

    private Models.Board.Task ActiveTask { get; set; }

    private bool openCardOverlay = false;

    private bool openDateOverlay = false;

    private bool Cycle = true;
    private int DateBodyIndex = 0;

    private void moveLeft (int currentIndex)
    {
        currentIndex = currentIndex is 0
            ? Date.Cards?.DistinctBy (card => card.BoardID).Count () ?? 0
            : currentIndex - 1;
    }

    private void moveRight (int currentIndex)
    {
        currentIndex = (currentIndex + 1) == Date.Cards?.DistinctBy (card => card.BoardID).Count ()
            ? 0
            : currentIndex + 1;
    }
}