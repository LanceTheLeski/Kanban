    private Month GetAllMonthDates (int year, int month)
    {
        var daysInMonth = DateTime.DaysInMonth (year, month);
        var firstDayOfMonth = new DateTime (year, month, 1);

        var newMonth = new Month ();

        newMonth.Weeks = new List<Week> ();
        newMonth.Weeks.Add (new Week ());
        var weekIndex = 0;

        for (var dayIndex = 0; dayIndex < daysInMonth; dayIndex ++)
        {
            switch (dayIndex % 7)
            {
                case 0:
                    newMonth.Weeks [weekIndex].Sunday = new Day { DayOfTheMonth = dayIndex };
                    break;
                case 1:
                    newMonth.Weeks [weekIndex].Monday = new Day { DayOfTheMonth = dayIndex };
                    break;
                case 2:
                    newMonth.Weeks [weekIndex].Tuesday = new Day { DayOfTheMonth = dayIndex };
                    break;
                case 3:
                    newMonth.Weeks [weekIndex].Wednesday = new Day { DayOfTheMonth = dayIndex };
                    break;
                case 4:
                    newMonth.Weeks [weekIndex].Thursday = new Day { DayOfTheMonth = dayIndex };
                    break;
                case 5:
                    newMonth.Weeks [weekIndex].Friday = new Day { DayOfTheMonth = dayIndex };
                    break;
                case 6:
                    newMonth.Weeks [weekIndex].Saturday = new Day { DayOfTheMonth = dayIndex };
                    newMonth.Weeks.Add (new Week ());
                    weekIndex += 1;
                    break;
            } 
        }

        return newMonth;
    }

    private double [] CountTaskTypes (List<MonthResponse.BasicTask> tasks)
    {
        var tasksDistinctByType = tasks.Select (task => task.TaskType)
                                       .Distinct ();

        var taskCounts = new double [tasksDistinctByType.Count ()];
        for (var taskCountIndex = 0; taskCountIndex < taskCounts.Length; taskCountIndex ++)
            taskCounts [taskCountIndex] = tasks.Where (task => task.TaskType == tasksDistinctByType.ElementAt (taskCountIndex))
                                               .Count ();

        return taskCounts;
    }

    private List<ChartSeries> GetTaskTypeData (List<MonthResponse.BasicTask> tasks)
    {
        var taskTypesList = tasks.Select (task => task.TaskType)
                                 .Distinct ();

        var tasksCompletedList = new List<ChartSeries> ();
        foreach (var taskType in taskTypesList)
        {
            var tasksCompleted = new double [taskTypesList.Count ()];
            for (var tasksIndex = 0; tasksIndex < tasksCompleted.Length; tasksIndex++)
                tasksCompleted [tasksIndex] = tasks.Where (task => task.TaskType == taskTypesList.ElementAt (tasksIndex)
                                                                   && task.isCompleted)
                                                   .Count ();

            tasksCompletedList.Add (new ChartSeries { Data = tasksCompleted });
        }

        return tasksCompletedList;
    }

